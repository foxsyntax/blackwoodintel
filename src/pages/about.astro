---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="About"
      description="Blackwood Intelligence conducts forensic analysis of systems, incentives, and structural failure."
    />
  </head>
  <body>
    <Header />
    <main>

      <h1 class="sr-only">About — Blackwood Intelligence</h1>

      <hr class="heavy" style="margin-top: 0; margin-bottom: 3rem;" />

      <!-- Opening -->
      <div class="about-opening">
        <p class="about-lead">
          Blackwood Intelligence conducts forensic analysis of systems, incentives, and structural failure.
        </p>
        <p class="about-sub">
          Our work focuses on how organizations, markets, and institutions behave under pressure —
          particularly when incentives, information flow, and operational reality begin diverging.
        </p>
        <p class="about-sub">
          Blackwood operates independently and publishes analysis exploring collapse dynamics,
          systemic adaptation, and strategic uncertainty across complex environments.
        </p>
      </div>

      <!-- Dossier sections -->
      <div class="about-body">

        <div class="about-row">
          <span class="about-row__label">Positioning</span>
          <div class="about-row__content">
            <p>Blackwood is a small independent research desk.</p>
            <p>Some work is published publicly through Analysis, Anatomy, and Signals.
            Other conversations remain private.</p>
            <p>The objective is not commentary, prediction theater, or narrative alignment.
            The objective is structural clarity: understanding how systems behave when pressure
            exceeds the assumptions holding them together.</p>
          </div>
        </div>

        <div class="about-row">
          <span class="about-row__label">Method</span>
          <div class="about-row__content">
            <p>Analysis begins with structural questions rather than conclusions.</p>
            <p>Each piece traces incentives, constraints, dependencies, and information flow
            to identify where systems become inconsistent with their apparent design.</p>
            <p>Where evidence is incomplete, uncertainty is stated explicitly rather than
            concealed behind certainty.</p>
          </div>
        </div>

        <div class="about-row">
          <span class="about-row__label">Signals</span>
          <div class="about-row__content">
            <p>Signals record shorter observations: early indicators, structural tensions,
            asymmetries, and emerging anomalies that may not yet justify full analysis.</p>
            <p>Some signals remain isolated. Others later develop into larger structural failures.</p>
          </div>
        </div>

        <div class="about-row">
          <span class="about-row__label">Engagements</span>
          <div class="about-row__content">
            <p>Blackwood occasionally works with researchers, operators, and organizations navigating:</p>
            <ul class="about-engagement-list">
              <li>systemic instability</li>
              <li>incentive misalignment</li>
              <li>strategic uncertainty</li>
              <li>organizational adaptation under pressure</li>
              <li>structural risk and failure dynamics</li>
            </ul>
            <p>Most conversations begin privately.</p>
          </div>
        </div>

        <div class="about-row about-row--contact">
          <span class="about-row__label">Contact</span>
          <div class="about-row__content">
            <p>For research discussions, inquiries, or private engagements:</p>
            <div class="about-contact-links">
              <a href="mailto:analysis@blackwoodintel.com">analysis@blackwoodintel.com</a>
              <a href="https://t.me/blackwoodintel" target="_blank" rel="noopener noreferrer">Telegram: @blackwoodintel</a>
            </div>
          </div>
        </div>

      </div>

    </main>
    <Footer />
  </body>
</html>

<style>
  /* ── Opening block ── */
  .about-opening {
    margin-bottom: 3.5rem;
  }

  .about-lead {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--text-primary);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .about-sub {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }

  .about-sub:last-child {
    margin-bottom: 0;
  }

  /* ── Dossier grid ── */
  .about-body {
    display: flex;
    flex-direction: column;
  }

  .about-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2.5rem;
    align-items: start;
    border-top: 1px solid var(--gray-200);
    padding: 1.75rem 0 2rem;
  }

  /* ── Row label ── */
  .about-row__label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.5;
    padding-top: 0.2rem;
  }

  /* ── Row content ── */
  .about-row__content p {
    font-family: var(--font-serif);
    font-size: 0.9875rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 0.9em;
  }

  .about-row__content p:last-child {
    margin-bottom: 0;
  }

  /* ── Engagements list ── */
  .about-engagement-list {
    list-style: none;
    padding: 0;
    margin: 0 0 0.9em 0;
  }

  .about-engagement-list li {
    font-family: var(--font-serif);
    font-size: 0.9875rem;
    color: var(--text-secondary);
    line-height: 1.8;
    padding-left: 1em;
    position: relative;
  }

  .about-engagement-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }

  /* ── Contact ── */
  .about-contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .about-contact-links a {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--gray-200);
    width: fit-content;
    padding-bottom: 1px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .about-contact-links a:hover {
    color: var(--black);
    border-bottom-color: var(--black);
  }

  /* ── Mobile ── */
  @media (max-width: 580px) {
    .about-row {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 1.5rem 0 1.75rem;
    }

    .about-row__label {
      padding-top: 0;
    }
  }
</style>
